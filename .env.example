# Copy to .env for local development. On Railway, set these as project
# environment variables instead of committing a real .env file.
#
# Variable names mirror Colossus (the sports-trading bot sharing this
# Polymarket.US account) wherever the concept is the same, so the two
# Railway projects are easy to manage side by side. Storm-only additions
# keep a STORM_ prefix.

# --- Polymarket.US credentials ---
# SAME account/key as Colossus. Do not rotate without coordinating - both
# bots will break. This is the polymarket-us SDK (Polymarket.US), a
# different API from the standard polymarket.com CLOB. Always required,
# even in dry-run - Storm discovers markets via this SDK, not just Gamma.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
# Fallback market source only, used if the SDK call fails/returns nothing.
GAMMA_HOST=https://gamma-api.polymarket.com

# --- Telegram (Storm's own bot - separate from Colossus's) ---
# Create a new bot via @BotFather, get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rate limiting (Storm's own conservative share of the shared account limit) ---
# Colossus doesn't run an explicit rate limiter of its own; keep this low
# enough that Storm's usage plus Colossus's stays under Polymarket's
# account-wide limit.
STORM_MAX_REQUESTS_PER_SECOND=2
STORM_RATE_LIMITER_BURST=4

# --- Trading safety ---
# Storm defaults to dry-run (logs intended trades, places nothing real).
# Set LIVE_TRADING=true explicitly (e.g. in Railway) to let it send real orders.
LIVE_TRADING=false
# Same idea as Colossus's PAUSED - stop opening new trades without a
# redeploy. Settable here, or live via Storm's /pause and /resume
# Telegram commands.
PAUSED=false
# Extra failsafe independent of PAUSED/Telegram: if this file exists on
# disk, Storm halts new trades on its next cycle.
STORM_KILL_SWITCH_FILE=storm.kill

MIN_TRADE_USD=0.10
MAX_TRADE_USD=1.00
MAX_TRADES_SESSION=10
# Storm-only extra guard beyond the trade-count cap above.
STORM_MAX_DAILY_SPEND_USDC=5.00
STORM_MIN_EDGE=0.08
# Fractional Kelly - position size scales with edge/confidence (still
# bounded by MIN/MAX_TRADE_USD above). 0.5 = half-Kelly; 1.0 = full Kelly
# (aggressive, more sensitive to error in the probability estimate); 0
# effectively disables Kelly sizing (falls through to the daily/session
# caps doing all the work).
STORM_KELLY_MULTIPLIER=0.5

# --- Weather data ---
# NWS / api.weather.gov - free, no key, but requires an identifying
# User-Agent per NWS policy.
NWS_USER_AGENT=storm-weather-bot (contact: you@example.com)
# Open-Meteo (api.open-meteo.com) needs no configuration - it's free,
# keyless, and used automatically as a second forecast source blended
# with NWS for a small ensemble. No env var to set.

# How often Storm re-scans markets and re-evaluates signals. Weather
# markets move slower than sports odds, so this doesn't need to be as
# tight as a sports bot's loop - but a full scan also makes several
# paginated API calls against the shared rate limit, so don't drop this
# far below ~60s without also raising STORM_MAX_REQUESTS_PER_SECOND.
SCAN_INTERVAL=120
LOG_LEVEL=INFO

# --- One-off diagnostics ---
# If set, Storm fetches this exact market slug directly (bypassing
# listing/category filtering entirely) once on startup and logs whether
# it's FOUND or NOT FOUND - a decisive test for whether this API key can
# access a specific known market at all. Grab a slug from a Temp market's
# URL in the app (the part after /event/). Leave blank for normal
# operation; not needed once the access question is resolved.
STORM_DIAGNOSTIC_PROBE_SLUG=

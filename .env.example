# Copy to .env for local development. On Railway, set these as project
# environment variables instead of committing a real .env file.

# --- Polymarket credentials ---
# Storm uses the SAME Polymarket account/API key as Colossus. Do not rotate
# these without coordinating - both bots will break.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Leave the three below blank to have Storm derive API creds from the
# private key on startup (client.create_or_derive_api_creds()).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

# --- Rate limiting (Storm's own conservative share of the shared account limit) ---
# Colossus runs its own limiter against the same key. These two together
# should stay comfortably under Polymarket's documented per-key rate limit.
STORM_MAX_REQUESTS_PER_SECOND=2
STORM_RATE_LIMITER_BURST=4

# --- Trading safety ---
# Storm defaults to dry-run (logs intended trades, places nothing real).
# Set LIVE_TRADING=true explicitly (e.g. in Railway) to let it send real orders.
LIVE_TRADING=false
# Immediate kill switch: set to true (env var, requires redeploy/restart) to
# stop Storm from opening new trades. Existing positions are left alone.
STORM_KILL_SWITCH=false
# Faster kill switch that doesn't need a redeploy: if this file exists on
# disk, Storm halts new trades on its next cycle.
STORM_KILL_SWITCH_FILE=storm.kill

STORM_MAX_POSITION_USDC=25
STORM_MAX_DAILY_SPEND_USDC=100
STORM_MIN_EDGE=0.08

# --- Weather data (NWS / api.weather.gov - free, no key, but requires an
# identifying User-Agent per NWS policy) ---
NWS_USER_AGENT=storm-weather-bot (contact: you@example.com)

STORM_POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
